alertcondition(enter_long, "🚀 LONG Signal", "LONG Entry - Confluence: {{plot_0}}/6 | Price: {{close}}")
alertcondition(enter_short, "🔻 SHORT Signal", "SHORT Entry - Confluence: {{plot_1}}/6 | Price: {{close}}")
alertcondition(exit_long_signal, "❌ Exit LONG", "Exit LONG signal triggered | Price: {{close}}")
alertcondition(exit_short_signal, "❌ Exit SHORT", "Exit SHORT signal triggered | Price: {{close}}")
